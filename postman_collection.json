{
  "info": {
    "name": "IMEI TAC Checker API",
    "description": "IMEI TAC & Fake Spec Refurbish Checker API - Verifikasi keaslian spesifikasi perangkat seluler berdasarkan TAC (8 digit awal IMEI).\n\nBase URL: http://localhost:3000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Check IMEI - HIGH RISK (Fake Spec)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"imei\": \"869887040000002\",\n  \"claimed_ram\": 8,\n  \"claimed_rom\": 128\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/check-imei",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "check-imei"]
        },
        "description": "Kasus terdeteksi palsu/refurbished. IMEI valid (OPPO A5, model code PBAM00) dengan klaim RAM 8GB & Storage 128GB yang melebihi batas pabrikan (max 4GB/64GB). PBAM00 juga masuk blacklist kode rekondisi."
      },
      "response": [
        {
          "name": "HIGH_RISK_FAKE Response",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"imei\": \"869887040000002\",\n  \"claimed_ram\": 8,\n  \"claimed_rom\": 128\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/check-imei",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "check-imei"]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ],
          "cookie": [],
          "body": "{\n  \"success\": true,\n  \"data\": {\n    \"imei\": \"869887040000002\",\n    \"tac\": \"86988704\",\n    \"device_info\": {\n      \"brand\": \"OPPO\",\n      \"model_name\": \"A5\",\n      \"model_code\": \"PBAM00\"\n    },\n    \"claimed_specs\": {\n      \"ram\": \"8 GB\",\n      \"storage\": \"128 GB\"\n    },\n    \"official_limits\": {\n      \"max_ram\": \"4 GB\",\n      \"max_storage\": \"64 GB\",\n      \"standard_variants\": [\"3/64 GB\", \"4/64 GB\"]\n    },\n    \"assessment\": {\n      \"is_refurbished_fake\": true,\n      \"risk_level\": \"HIGH\",\n      \"verdict\": \"BAHAYA: Unit Refurbish / Spek Dimanipulasi\",\n      \"reasons\": [\n        \"Klaim RAM 8 GB melebihi batas hardware maksimum pabrikan (Maks: 4 GB).\",\n        \"Klaim Storage 128 GB melebihi batas maksimum model ini (Maks: 64 GB).\",\n        \"Kode model PBAM00 teridentifikasi sebagai varian distributor rekondisi.\"\n      ]\n    }\n  }\n}"
        }
      ]
